# Copy to .env (never commit .env). In Komodo, paste these into the stack's Environment instead.

# --- Actual Budget ---
# Use the LAN address so nothing goes over the internet. If the server uses a
# self-signed certificate, mount it and set NODE_EXTRA_CA_CERTS to its path.
ACTUAL_SERVER_URL=https://192.168.1.10:5006
ACTUAL_PASSWORD=
# Actual > Settings > Show advanced settings > Sync ID
ACTUAL_SYNC_ID=
# Only if the budget uses end-to-end encryption
ACTUAL_E2E_PASSWORD=
# NODE_EXTRA_CA_CERTS=/data/actual-ca.pem

# --- Gmail (read-only over IMAP) ---
# Create an app password at https://myaccount.google.com/apppasswords (needs 2-Step Verification).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# Comma-separated senders whose emails are transaction alerts
ALERT_SENDERS=capitalone@notification.capitalone.com,no.reply.alerts@chase.com
LOOKBACK_DAYS=3

# Last 4 digits in the email -> exact Actual account name
ACCOUNT_MAP={"1234": "Checking", "5678": "Credit Card"}

# --- Claude ---
# From https://console.anthropic.com (pay-as-you-go, separate from a Claude.ai subscription)
ANTHROPIC_API_KEY=
# Cheapest model; plenty for reading alert emails and picking categories.
CLAUDE_MODEL=claude-haiku-4-5
# Only for models that support it (not Haiku), e.g. low
# CLAUDE_EFFORT=

# --- Bank export files and backups (only used if the folders are mounted) ---
# IMPORT_DIR=/import
# DONE_DIR=/done
# IMPORT_POLL_MINUTES=5
# BACKUP_DIR=/backups
# BACKUP_KEEP=30

# --- Web page (status, Scan now, review list) ---
# WEB_PORT=8080
# Any username, this password. Recommended if the page is reachable beyond your LAN.
# WEB_PASSWORD=

# --- Behavior ---
# Start with true: logs what it would do without writing to Actual.
DRY_RUN=true
CATEGORIZE=true
CATEGORIZE_DAYS=30
MIN_CONFIDENCE=0.8
# Every 2 hours
SCHEDULE=0 */2 * * *
TZ=America/New_York
